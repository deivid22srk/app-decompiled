<?xml version="1.0" encoding="utf-8"?>
<com.google.android.wallet.instrumentmanager.ui.InstrumentManagerRootFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:im="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="420dp"
    im:maxWidth="?attr/imMaxWidth">
    <com.google.android.wallet.ui.common.FifeNetworkImageView
        android:id="@+id/title_image"
        android:background="?attr/imTitleImageBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="200dp">
        <FrameLayout
            android:background="?attr/imTitleTextBackground"
            android:paddingLeft="?attr/imTitleStartMargin"
            android:paddingTop="?attr/imTitleTopMargin"
            android:paddingRight="?attr/imTitleEndMargin"
            android:paddingBottom="?attr/imTitleBottomMargin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/top_bar"
                android:visibility="invisible"
                layout="@layout/view_top_bar"/>
            <include
                android:id="@+id/progress_top_bar"
                android:visibility="invisible"
                layout="@layout/view_top_bar"/>
        </FrameLayout>
        <View
            android:id="@+id/title_separator"
            android:background="?attr/imTitleSeparatorBackground"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="?attr/imTitleSeparatorHeight"/>
        <ScrollView
            android:id="@+id/main_content"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="?attr/uicFormStartEndMargin"
            android:layout_marginTop="?attr/uicFormTopMargin"
            android:layout_marginRight="?attr/uicFormStartEndMargin"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/sub_form_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.wallet.instrumentmanager.ui.common.ImInfoMessageTextView
                    android:id="@+id/top_info_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="?attr/internalUicNonFormFieldTextStartMargin"
                    android:layout_marginBottom="@dimen/wallet_im_info_message_bottom_margin"
                    style="?attr/imInfoMessageTextAppearance"/>
                <com.google.android.wallet.instrumentmanager.ui.common.ImInfoMessageTextView
                    android:id="@+id/info_message"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    style="?attr/uicDialogMessageTextAppearance"/>
                <TextView
                    android:id="@+id/details"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textIsSelectable="true"
                    style="?android:attr/textAppearanceSmall"/>
            </LinearLayout>
        </ScrollView>
        <include
            android:id="@+id/button_bar"
            android:visibility="invisible"
            layout="@layout/view_button_bar"/>
        <View
            android:id="@+id/steal_focus_and_hide_keyboard"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <View
            android:id="@+id/focus_stealer"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:paddingLeft="?attr/uicFormStartEndMargin"
        android:paddingRight="?attr/uicFormStartEndMargin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progress_bar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            style="?attr/imProgressBarStyle"/>
        <TextView
            android:id="@+id/progress_text"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/wallet_im_progress_text_margin"
            android:maxLines="5"
            android:layout_toRightOf="@+id/progress_bar"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            style="?attr/imProgressBarTextAppearance"/>
    </RelativeLayout>
</com.google.android.wallet.instrumentmanager.ui.InstrumentManagerRootFrameLayout>
