<?xml version="1.0" encoding="utf-8"?>
<com.google.android.wallet.instrumentmanager.ui.InstrumentManagerRootLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.wallet.ui.common.FifeNetworkImageView
        android:id="@+id/title_image"
        android:background="?attr/imTitleImageBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="256dp"/>
    <FrameLayout
        android:background="?attr/imTitleTextBackground"
        android:paddingTop="?attr/imTitleTopMargin"
        android:paddingBottom="?attr/imTitleBottomMargin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/imTitleStartMargin"
        android:paddingEnd="?attr/imTitleEndMargin">
        <include
            android:id="@+id/top_bar"
            android:visibility="invisible"
            layout="@layout/view_top_bar"/>
        <include
            android:id="@+id/progress_top_bar"
            android:visibility="invisible"
            layout="@layout/view_top_bar"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="?attr/imTitleSeparatorStartEndMargin"
            android:layout_marginEnd="?attr/imTitleSeparatorStartEndMargin">
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/title_separator"
                android:background="?attr/imTitleSeparatorBackground"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="?attr/imTitleSeparatorHeight"/>
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/progress_bar"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="?attr/imProgressBarTopMargin"
                android:indeterminate="true"
                style="?attr/imProgressBarStyle"/>
        </FrameLayout>
        <TextView
            android:id="@+id/progress_text"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="?attr/uicFormTopMargin"
            android:layout_marginStart="?attr/uicFormStartEndMargin"
            android:layout_marginEnd="?attr/uicFormStartEndMargin"
            style="?attr/imProgressBarTextAppearance"/>
        <com.google.android.wallet.ui.common.FocusedViewToTopScrollView
            android:id="@+id/main_content"
            android:visibility="invisible"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="?attr/uicFormTopMargin"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="?attr/uicFormStartEndMargin"
                android:paddingEnd="?attr/uicFormStartEndMargin">
                <com.google.android.wallet.instrumentmanager.ui.common.ImInfoMessageTextView
                    android:id="@+id/top_info_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/wallet_im_info_message_bottom_margin"
                    android:layout_marginStart="?attr/internalUicNonFormFieldTextStartMargin"
                    style="?attr/imInfoMessageTextAppearance"/>
                <FrameLayout
                    android:id="@+id/sub_form_holder"
                    android:clipChildren="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.google.android.wallet.instrumentmanager.ui.common.ImInfoMessageTextView
                    android:id="@+id/info_message"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    style="?attr/uicDialogMessageTextAppearance"/>
                <TextView
                    android:id="@+id/details"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textIsSelectable="true"
                    style="?android:attr/textAppearanceSmall"/>
            </LinearLayout>
        </com.google.android.wallet.ui.common.FocusedViewToTopScrollView>
    </FrameLayout>
    <include
        android:id="@+id/button_bar"
        layout="@layout/view_button_bar"/>
    <View
        android:id="@+id/steal_focus_and_hide_keyboard"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <View
        android:id="@+id/focus_stealer"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
</com.google.android.wallet.instrumentmanager.ui.InstrumentManagerRootLinearLayout>
