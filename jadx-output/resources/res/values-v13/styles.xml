<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OnboardTab" parent="@style/PlayMediumBoldText">
        <item name="android:textColor">@color/play_white</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="PlayOnboardNavFooterButton" parent="">
        <item name="android:textAppearance">@style/PlayCardAction</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/play_onboard_dark_button_bg</item>
        <item name="android:paddingLeft">@dimen/play_onboard__onboard_nav_footer_button_padding</item>
        <item name="android:paddingRight">@dimen/play_onboard__onboard_nav_footer_button_padding</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:maxHeight">48dp</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="SetupWizardNavbarButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/setup_wizard_navbar_text_color</item>
        <item name="android:background">@drawable/setup_wizard_navbar_btn_bg</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:layout_weight">0</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
