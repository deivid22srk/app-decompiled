<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FinskyInstrumentManagerExpandButton" parent="">
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:textColor">@color/play_fg_secondary</item>
        <item name="android:background">@drawable/play_highlight_overlay_light</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableStart">@drawable/ic_more_details_light</item>
    </style>
    <style name="OnboardTab" parent="@style/PlayMediumBoldText">
        <item name="android:textColor">@color/play_white</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="PlayDrawerDownloadToggle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textOn"> </item>
        <item name="android:textOff"> </item>
        <item name="android:switchMinWidth">56dp</item>
    </style>
    <style name="PlayOnboardNavFooterButton" parent="">
        <item name="android:textAppearance">@style/PlayCardAction</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/play_onboard_dark_button_bg</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:maxHeight">48dp</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="SetupWizardAppsRowEntry" parent="">
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">?android:attr/listPreferredItemHeightSmall</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableStart">?android:attr/listChoiceIndicatorMultiple</item>
    </style>
    <style name="SetupWizardNavbarButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/setup_wizard_navbar_text_color</item>
        <item name="android:background">@drawable/setup_wizard_navbar_btn_bg</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:layout_weight">0</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
