<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/edit_section"
    android:nextFocusDown="@+id/name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/enter_your_billing_address"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/enter_your_address_sentence"
        style="@style/SetupWizardLightText"/>
    <EditText
        android:id="@+id/phone_number_edit"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/phone_number"
        android:singleLine="true"
        android:inputType="phone"/>
    <EditText
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:hint="@string/name_label"
        android:singleLine="true"
        android:inputType="textCapWords"/>
    <include
        android:id="@+id/address_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/address_layout"/>
</LinearLayout>
