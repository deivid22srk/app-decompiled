<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/carrier_tos_and_address_main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/addinstrument_introduction"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/SetupWizardLightText"/>
    <TextView
        android:id="@+id/addinstrument_password_info"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/SetupWizardDetails"/>
    <TextView
        android:id="@+id/billing_information_description"
        android:paddingBottom="22dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/SetupWizardDetails"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/play_purchase_secondary_size"
            android:id="@+id/address_display"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/AddInstrumentBodyTextAddressSnippet"/>
        <ImageButton
            android:id="@+id/address_edit_button"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_btn_billing_edit"
            android:contentDescription="@string/content_description_edit_address"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/play_purchase_secondary_size"
        android:id="@+id/phone_number_display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        style="@style/AddInstrumentBodyTextAddressSnippet"/>
    <TextView
        android:id="@+id/tos_footer"
        android:paddingTop="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/SetupWizardDetails"/>
    <RadioGroup
        android:id="@+id/tos_radio_group"
        android:paddingTop="13dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RadioButton
            android:id="@+id/tos_accept"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/accept"
            style="@style/SetupWizardLightText"/>
        <RadioButton
            android:id="@+id/tos_decline"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/decline"
            style="@style/SetupWizardLightText"/>
    </RadioGroup>
</LinearLayout>
