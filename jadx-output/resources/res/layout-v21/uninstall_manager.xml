<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/uninstall_manager"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/play_fg_primary"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uninstall_manager_title"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/play_fg_secondary"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uninstall_manager_subtitle"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/play_fg_primary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/uninstall_manager_storage_text"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PlayLightText"/>
        <ProgressBar
            android:id="@+id/uninstall_manager_progress_bar"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progressTint="@color/play_apps_primary"
            android:secondaryProgressTint="@color/play_apps_secondary"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/play_fg_secondary"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/uninstall_manager_checked_text"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PlayLightText"/>
        <com.google.android.finsky.layout.play.PlayRecyclerView
            android:id="@+id/uninstall_recycler_view"
            android:fadingEdgeLength="0dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:cacheColorHint="@color/play_main_background"
            android:divider="@null"
            android:layout_weight="1"/>
        <include
            android:paddingTop="38dp"
            layout="@layout/button_bar"/>
    </LinearLayout>
    <com.google.android.finsky.layout.MarginBox
        android:id="@+id/no_results_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/content_generic_large_size"
            android:textColor="@color/play_fg_secondary"
            android:gravity="center"
            android:layout_gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/uninstall_manager_no_results"
            style="@style/PlayLightText"/>
    </com.google.android.finsky.layout.MarginBox>
</FrameLayout>
