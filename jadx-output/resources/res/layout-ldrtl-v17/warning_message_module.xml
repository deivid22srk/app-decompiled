<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.detailspage.WarningMessageModuleLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/warning_message_module"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/details_special_row_min_height"
    android:paddingStart="@dimen/details_new_content_margin"
    android:paddingEnd="@dimen/details_new_content_margin">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/warning_message_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"
        android:paddingEnd="24dp"/>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/warning_message"
        style="@style/WarningMessageText"/>
</com.google.android.finsky.detailspage.WarningMessageModuleLayout>
