<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.ReviewsTipHeaderLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/review_tip_container"
    android:paddingTop="18dp"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/tip_header_fullline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/details_new_content_margin"
        android:paddingEnd="@dimen/details_new_content_margin">
        <TextView
            android:textSize="@dimen/content_generic_medium_size"
            android:textStyle="bold"
            android:textColor="@color/play_fg_primary"
            android:ellipsize="none"
            android:layout_gravity="start|bottom"
            android:id="@+id/tip_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:paddingEnd="8dp"
            style="@style/PlayPlainText"/>
        <TextView
            android:textSize="@dimen/content_generic_small_size"
            android:ellipsize="none"
            android:layout_gravity="end|bottom"
            android:id="@+id/tip_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            style="@style/PlayPlainText"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/content_generic_medium_size"
        android:textStyle="bold"
        android:textColor="@color/play_fg_primary"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tip_title_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/details_new_content_margin"
        android:paddingEnd="@dimen/details_new_content_margin"
        style="@style/PlayPlainText"/>
    <TextView
        android:textSize="@dimen/content_generic_small_size"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tip_info_line2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/details_new_content_margin"
        android:paddingEnd="@dimen/details_new_content_margin"
        style="@style/PlayPlainText"/>
</com.google.android.finsky.layout.ReviewsTipHeaderLayout>
