<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.android.vending"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="8dp"
    android:paddingEnd="12dp">
    <com.google.android.play.image.FifeImageView
        android:id="@+id/thumbnail_image"
        android:visibility="gone"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignWithParentIfMissing="true"
        android:paddingStart="8dp"
        android:layout_toStartOf="@+id/check_mark"
        android:layout_toEndOf="@+id/thumbnail_image">
        <com.google.android.play.layout.PlayTextView
            android:textSize="@dimen/play_purchase_primary_size"
            android:ellipsize="end"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            finsky:allowsCompactLineSpacing="true"
            style="@style/LightPurchase_TitleText"/>
        <com.google.android.play.layout.PlayTextView
            android:id="@+id/title_byline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/LightPurchase_PriceByline"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/check_mark"
        android:paddingTop="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_check_badge_big"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textColor="@color/play_apps_primary"
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_below="@+id/title_wrapper"
        android:layout_alignWithParentIfMissing="true"
        android:paddingStart="8dp"
        android:layout_toEndOf="@+id/image"
        style="@style/LightPurchase_Details"/>
</RelativeLayout>
