<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.RewardRowView2 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.android.vending"
    android:id="@+id/reward_row"
    style="@style/MyAccountListPageRow">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.play.layout.PlayCardThumbnail
            android:id="@+id/li_thumbnail_frame"
            finsky:app_thumbnail_padding="0dp"
            style="@style/MyAccountThumbnail2">
            <include
                android:id="@+id/li_thumbnail"
                layout="@layout/play_card_thumbnail"/>
        </com.google.android.play.layout.PlayCardThumbnail>
        <TextView
            android:id="@+id/title"
            android:layout_alignWithParentIfMissing="true"
            android:layout_toEndOf="@+id/li_thumbnail_frame"
            style="@style/MyAccountListPagePrice"/>
        <TextView
            android:id="@+id/expiration_description"
            android:layout_below="@+id/title"
            android:layout_alignWithParentIfMissing="true"
            android:layout_toEndOf="@+id/li_thumbnail_frame"
            style="@style/MyAccountListPageSubtitle"/>
        <TextView
            android:id="@+id/reward_description"
            android:layout_below="@+id/expiration_description"
            android:layout_toEndOf="@+id/li_thumbnail_frame"
            style="@style/MyAccountListPageDetails"/>
        <com.google.android.play.layout.PlayActionButton
            android:id="@+id/redeem_button"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            style="@style/MyAccountRowButton2"/>
    </RelativeLayout>
</com.google.android.finsky.layout.RewardRowView2>
