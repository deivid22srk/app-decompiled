<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/expanded_content"
    android:paddingBottom="24dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/details_new_content_margin"
    android:paddingEnd="@dimen/details_new_content_margin">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/screencap_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/episode_screencap"
            layout="@layout/hero_graphic"/>
    </FrameLayout>
    <TextView
        android:id="@+id/episode_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/PlayDetailDescription"/>
</LinearLayout>
