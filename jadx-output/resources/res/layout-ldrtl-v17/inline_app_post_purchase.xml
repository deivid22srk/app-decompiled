<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.finsky.layout.InlineDetailsSummary
        android:id="@+id/title_details_summary"
        android:background="@color/play_white"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.play.layout.PlayTextView
            android:id="@+id/title_title"
            android:background="@drawable/play_highlight_overlay_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            finsky:allowsCompactLineSpacing="true"
            style="@style/PlayDetailTitle"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_creator_panel"
            android:background="@drawable/play_highlight_overlay_light"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.finsky.layout.DecoratedTextView
                android:id="@+id/title_creator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="4dp"
                style="@style/Play_DetailsPage_Subtitle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:id="@+id/title_extra_labels"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"/>
        <com.google.android.finsky.layout.DetailsSummaryDynamic
            android:id="@+id/title_details_summary_dynamic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <LinearLayout
                android:id="@+id/button_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.play.layout.PlayActionButton
                    android:id="@+id/launch_button"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:text="@string/open"
                    style="@style/Play_DetailsPage_ActionButton"/>
            </LinearLayout>
            <include
                android:id="@+id/download_progress_panel"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/details_download_progress"/>
            <TextView
                android:textSize="@dimen/content_generic_small_size"
                android:textColor="@color/play_fg_secondary"
                android:gravity="center"
                android:id="@+id/summary_dynamic_status"
                android:paddingTop="4dp"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                style="@style/PlayLightText"/>
        </com.google.android.finsky.layout.DetailsSummaryDynamic>
    </com.google.android.finsky.layout.InlineDetailsSummary>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/suggestion_cluster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/inline_app_details_footer"
        android:background="@color/play_white"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/logo_googleplay"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/play_apps_primary"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/cont"
            android:background="@drawable/play_highlight_overlay_light"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/continue_text"
            style="@style/PlayCardAction"/>
    </LinearLayout>
</LinearLayout>
