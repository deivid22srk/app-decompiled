<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/family_member_settings_header"/>
        <include layout="@layout/my_account_separator"/>
        <com.google.android.play.layout.CardLinearLayout
            android:orientation="vertical"
            android:id="@+id/teen_purchase_settings_card"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            style="@style/PlayCardViewGroup">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/purchase_card_title"
                android:padding="16dp"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:singleLine="false"
                style="@style/PlayClusterTitle"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/play_fg_primary"
                android:textColorLink="@color/unicorn_accent"
                android:id="@+id/purchase_settings_learn_more_explanation"
                android:background="@color/unicorn_accent_translucent"
                android:padding="16dp"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <RadioGroup
                android:orientation="vertical"
                android:id="@+id/purchase_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </com.google.android.play.layout.CardLinearLayout>
    </LinearLayout>
</ScrollView>
