<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.PlayGamesInstallView xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/play_games_install_suggestion_text"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:gravity="start"
        android:id="@+id/bullet_list"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="16dp"/>
</com.google.android.finsky.layout.PlayGamesInstallView>
