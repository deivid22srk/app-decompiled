<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.DetailsTextBlock xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    finsky:regular_style_xmargin="@dimen/details_text_section_padding">
    <ImageView
        android:id="@+id/icon"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/details_new_content_margin"/>
    <com.google.android.finsky.layout.AccessibleTextView
        android:id="@+id/body_header"
        android:paddingTop="2dp"
        android:clickable="false"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:layout_toEndOf="@+id/icon"
        style="@style/PlayDetailsTextTitle"/>
    <com.google.android.finsky.layout.DetailsTextView
        android:id="@+id/body"
        android:paddingBottom="12dp"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/body_header"
        android:layout_toEndOf="@+id/icon"
        finsky:lastLineOverdrawColor="@color/white"
        style="@style/PlayDetailDescription"/>
</com.google.android.finsky.layout.DetailsTextBlock>
