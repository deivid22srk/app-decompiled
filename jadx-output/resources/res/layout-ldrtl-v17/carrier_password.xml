<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/carrier_password_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:scrollbarStyle="insideInset"
            android:orientation="vertical"
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="top|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/carrier_password_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/content_generic_large_size"
                    android:id="@+id/password_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <EditText
                    android:textSize="@dimen/content_generic_large_size"
                    android:id="@+id/password_edit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:gravity="end"
                    android:id="@+id/password_forgot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="16dp"/>
            </LinearLayout>
        </ScrollView>
        <include layout="@layout/button_bar"/>
    </LinearLayout>
    <include
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/page_loading_indicator"/>
</FrameLayout>
