<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.FamilyShareToggle xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/play_highlight_overlay_light"
    android:padding="@dimen/details_content_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/family_icon"
        android:layout_width="@dimen/details_text_section_icon_size"
        android:layout_height="@dimen/details_text_section_icon_size"
        android:scaleType="fitStart"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="@dimen/content_generic_small_size"
        android:textColor="@color/play_primary_text"
        android:ellipsize="end"
        android:id="@+id/action_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/details_content_margin"
        android:layout_toEndOf="@+id/family_icon"/>
    <android.support.v7.widget.SwitchCompat
        android:id="@+id/switch_button"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@+id/action_text"
        android:layout_alignParentEnd="true"
        style="@style/PlayDrawerDownloadToggle"/>
</com.google.android.finsky.layout.FamilyShareToggle>
