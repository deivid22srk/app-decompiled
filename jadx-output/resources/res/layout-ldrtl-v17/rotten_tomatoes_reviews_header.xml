<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.RottenTomatoesReviewsHeader xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:padding="@dimen/details_new_content_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/content_generic_xsmall_size"
        android:textStyle="bold"
        android:textColor="@color/play_fg_primary"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/PlayPlainText"/>
    <com.google.android.play.image.FifeImageView
        android:id="@+id/sentiment_image"
        android:layout_width="@dimen/review_avatar_size"
        android:layout_height="@dimen/review_avatar_size"
        android:layout_marginTop="24dp"
        android:scaleType="fitStart"
        android:layout_below="@+id/title"
        finsky:fixed_bounds="true"/>
    <TextView
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@color/play_fg_primary"
        android:id="@+id/favorable_percent_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_below="@+id/title"
        android:layout_marginStart="@dimen/details_new_content_margin"
        android:layout_toEndOf="@+id/sentiment_image"
        style="@style/PlayPlainText"/>
    <TextView
        android:textSize="21sp"
        android:textStyle="bold"
        android:textColor="@color/play_fg_primary"
        android:id="@+id/favorable_percent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/rotten_tomatoes_percent"
        android:layout_below="@+id/title"
        android:layout_marginStart="4dp"
        android:layout_toEndOf="@+id/favorable_percent_value"
        style="@style/PlayPlainText"/>
    <TextView
        android:textSize="@dimen/content_generic_small_size"
        android:textColor="@color/play_fg_primary"
        android:id="@+id/reviews_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/favorable_percent_value"
        android:layout_marginStart="@dimen/details_new_content_margin"
        android:layout_toEndOf="@+id/favorable_percent"
        style="@style/PlayPlainText"/>
    <com.google.android.finsky.layout.RottenTomatoesMeter
        android:id="@+id/favorable_percent_bar"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp"
        android:layout_below="@+id/favorable_percent_value"/>
    <TextView
        android:textSize="@dimen/content_generic_xsmall_size"
        android:textColor="@color/play_movies_secondary_text"
        android:id="@+id/source"
        android:background="@drawable/play_highlight_overlay_light"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/favorable_percent_bar"
        style="@style/PlayPlainText"/>
</com.google.android.finsky.layout.RottenTomatoesReviewsHeader>
