<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/focus_overlay"
    android:paddingTop="@dimen/my_account_row_ypadding"
    android:paddingBottom="@dimen/my_account_row_ypadding"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/my_account_row_height"
    android:paddingStart="20dp"
    android:paddingEnd="@dimen/my_account_row_xpadding">
    <com.google.android.play.image.FifeImageView
        android:id="@+id/image_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:ellipsize="end"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="@integer/instrument_title_max_rows"
            android:textAlignment="viewStart"
            style="@style/PlayCardTitle"/>
        <TextView
            android:id="@+id/subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/PlayCardSubtitle"/>
        <TextView
            android:textColor="@color/instrument_error_text"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/byline"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            style="@style/PlayCardSubtitle"/>
    </LinearLayout>
    <TextView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/edit_button"
        android:visibility="gone"
        style="@style/PaymentMethodsRowEditButton"/>
</LinearLayout>
