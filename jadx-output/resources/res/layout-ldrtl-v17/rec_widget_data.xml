<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="@dimen/widget_primary_font_size"
        android:textColor="@color/play_white"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:shadowColor="#80000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:layout_below="@+id/widget_overlay"
        android:paddingStart="8dp"
        android:paddingEnd="36dp"
        android:layout_toStartOf="@+id/widget_dismiss"
        android:layout_toEndOf="@+id/widget_promo"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/widget_secondary_font_size"
        android:textColor="#b0b0b0"
        android:ellipsize="end"
        android:id="@+id/widget_creator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_below="@+id/widget_title"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_toEndOf="@+id/widget_promo"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="@dimen/widget_secondary_font_size"
        android:textColor="#b0b0b0"
        android:ellipsize="end"
        android:id="@+id/widget_reason"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:maxLines="2"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@+id/widget_dismiss"
        android:layout_toEndOf="@+id/widget_promo"/>
</merge>
