<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/page_error_indicator"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_play_store_icon_watermark"
        android:scaleType="fitStart"/>
    <TextView
        android:textSize="@dimen/content_generic_large_size"
        android:textColor="@color/play_white"
        android:gravity="center"
        android:id="@+id/error_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <FrameLayout
        android:id="@+id/widget_retry"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:paddingStart="12dp"
        android:layout_alignParentEnd="true">
        <ImageView
            android:background="@drawable/play_highlight_overlay_dark"
            android:padding="2dp"
            android:duplicateParentState="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_play_widgets_refresh"/>
    </FrameLayout>
</RelativeLayout>
