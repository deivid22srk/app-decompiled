<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:paddingTop="?attr/uicFormListTopBottomPadding"
    android:paddingBottom="?attr/uicFormListTopBottomPadding"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/uicFormItemHeight"
    android:paddingStart="?attr/uicFormListStartEndPadding"
    android:paddingEnd="?attr/uicFormListStartEndPadding"
    style="@style/UicClickableItem">
    <com.google.android.wallet.ui.common.ImageWithCaptionView
        android:layout_gravity="center_vertical"
        android:id="@+id/icon"
        android:visibility="gone"
        android:layout_width="?attr/uicFormListIconSize"
        android:layout_height="?attr/uicFormListIconSize"
        android:layout_marginEnd="?attr/uicFormListIconMargin"/>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="?attr/uicFormInputTextAppearance"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/selection_indicator"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/uicFormListSelectionIndicator"
        android:layout_marginStart="?attr/uicFormListSelectionIndicatorMargin"/>
</LinearLayout>
