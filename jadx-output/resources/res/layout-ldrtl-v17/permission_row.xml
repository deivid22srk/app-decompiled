<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/permission_row"
    android:background="@drawable/focus_overlay"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="45dp"
    android:paddingStart="11dp"
    android:paddingEnd="10dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/bucket_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/play_primary_text"
            android:id="@+id/header"
            android:paddingTop="1dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="0sp"
            android:paddingStart="22dp"
            android:paddingEnd="16dp"
            style="@style/PermissionRow"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/expander_icon"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_menu_expander_minimized_light"
            android:contentDescription="@string/content_description_toggle_expand"/>
    </LinearLayout>
    <TextView
        android:id="@+id/content"
        android:paddingTop="5dp"
        android:layout_width="match_parent"
        android:lineSpacingExtra="1sp"
        android:paddingStart="50dp"
        style="@style/PermissionRow"/>
</LinearLayout>
