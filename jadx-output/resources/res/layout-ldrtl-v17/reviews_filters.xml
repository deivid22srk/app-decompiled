<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.ReviewsControlContainer xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:orientation="horizontal"
    android:paddingTop="20dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/details_new_content_margin"
    android:paddingEnd="@dimen/details_new_content_margin">
    <com.google.android.finsky.layout.AccessibleTextView
        android:textSize="@dimen/content_generic_medium_size"
        android:textColor="@color/reviews_filtering_color"
        android:id="@+id/reviews_sort_box"
        android:background="@drawable/spinner_ab_background_holo_light"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/reviews_sort_by_helpfulness"
        android:layout_weight="1"
        android:paddingStart="0dp"
        finsky:playAccessibilityClassOverride="android.widget.Spinner"/>
    <com.google.android.finsky.layout.AccessibleTextView
        android:textSize="@dimen/content_generic_medium_size"
        android:textColor="@color/reviews_filtering_color"
        android:gravity="end"
        android:id="@+id/reviews_filter_box"
        android:background="@drawable/spinner_ab_background_holo_light"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/reviews_filter_options"
        android:layout_weight="1"
        android:paddingEnd="24dp"
        finsky:playAccessibilityClassOverride="android.widget.Spinner"/>
</com.google.android.finsky.layout.ReviewsControlContainer>
