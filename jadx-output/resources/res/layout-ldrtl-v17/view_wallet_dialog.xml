<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="?attr/uicDialogBodyTopBottomMargin"
        android:paddingBottom="?attr/uicDialogBodyTopBottomMargin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/uicDialogBodyStartEndMargin"
        android:paddingEnd="?attr/uicDialogBodyStartEndMargin">
        <com.google.android.wallet.ui.common.InfoMessageTextView
            android:id="@+id/info_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            style="?attr/uicDialogMessageTextAppearance"/>
        <TextView
            android:id="@+id/details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            style="?android:attr/textAppearanceSmall"/>
    </LinearLayout>
</ScrollView>
