<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/refund_whitespace_large"
    android:layout_marginEnd="@dimen/refund_whitespace_large">
    <TextView
        android:id="@+id/title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/refund_whitespace_medium"
        style="@style/PlayRefundTitle"/>
    <TextView
        android:id="@+id/subtitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/refund_whitespace_small"
        style="@style/PlayRefundSubtitle"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/refund_whitespace_medium"
        style="@style/PlayRefundText"/>
    <ScrollView
        android:id="@+id/reasons_scroll_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/refund_whitespace_medium"
        android:layout_weight="1">
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/reasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
</LinearLayout>
