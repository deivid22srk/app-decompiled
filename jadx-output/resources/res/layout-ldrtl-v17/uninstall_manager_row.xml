<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/uninstall_row"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <com.google.android.finsky.layout.DocImageView
        android:id="@+id/uninstall_row_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/play_primary_text"
            android:ellipsize="end"
            android:id="@+id/uninstall_row_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/play_secondary_text"
            android:ellipsize="end"
            android:id="@+id/uninstall_row_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/play_secondary_text"
        android:id="@+id/uninstall_row_uninstalling"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/uninstalling"/>
    <CheckBox
        android:id="@+id/uninstall_row_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
