<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/carrier_billing_edit"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:scrollbarStyle="insideInset"
        android:orientation="vertical"
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="top|center_horizontal"
            android:orientation="vertical"
            android:id="@+id/edit_section"
            android:nextFocusDown="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/addinstrument_content_padding"
            android:paddingEnd="@dimen/addinstrument_content_padding">
            <TextView
                android:id="@+id/enter_your_billing_address"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enter_your_address_sentence"
                style="@style/SetupWizardLightText"/>
            <EditText
                android:id="@+id/phone_number_edit"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/phone_number"
                android:singleLine="true"
                android:inputType="phone"/>
            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="@string/name_label"
                android:singleLine="true"
                android:inputType="textCapWords"/>
            <include
                android:id="@+id/address_widget"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/address_layout"/>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/setup_wizard_stacked_buttons"/>
</LinearLayout>
