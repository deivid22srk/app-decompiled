<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.SeparatorLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:background="@drawable/focus_overlay"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp">
    <com.google.android.play.image.FifeImageView
        android:id="@+id/image_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="8dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            style="@style/BillingProfile_Disabled_Entry"/>
        <TextView
            android:id="@+id/subtitle"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/BillingProfile_Entry_Subtitle"/>
        <TextView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/byline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            style="@style/BillingProfile_Disabled_Entry_Byline"/>
    </LinearLayout>
    <TextView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/edit_button"
        android:visibility="gone"
        style="@style/PaymentMethodsRowEditButton"/>
</com.google.android.finsky.layout.SeparatorLinearLayout>
