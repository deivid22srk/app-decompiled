<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/background_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/alt_play_background"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/alt_play_colored_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="-1px"
        android:layout_marginBottom="@dimen/play_header_list_header_shadow_height">
        <View
            android:id="@+id/colored_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <FrameLayout
            android:layout_gravity="bottom"
            android:id="@+id/tab_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/play_header_list_tab_strip_height">
            <com.google.android.play.headerlist.PlayHeaderListTabStrip
                android:id="@+id/pager_tab_strip"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <HorizontalScrollView
                    android:id="@+id/play_header_list_tab_scroll"
                    android:scrollbars="none"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <com.google.android.play.headerlist.PlayHeaderListTabContainer
                        android:orientation="horizontal"
                        android:id="@+id/play_header_list_tab_container"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layoutDirection="locale"/>
                </HorizontalScrollView>
            </com.google.android.play.headerlist.PlayHeaderListTabStrip>
            <TextView
                android:textColor="@android:color/white"
                android:layout_gravity="center"
                android:id="@+id/tab_bar_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/PlayHeaderListTabText"/>
        </FrameLayout>
    </FrameLayout>
    <View
        android:layout_gravity="top"
        android:id="@+id/header_shadow"
        android:background="@drawable/play_header_list_shadow"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/play_header_list_header_shadow_height"/>
    <FrameLayout
        android:layout_gravity="top"
        android:id="@+id/toolbar_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:gravity="center"
        android:layout_gravity="top"
        android:id="@+id/play_header_banner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/play_header_list_banner_height"
        style="@style/PlayHeaderListBannerText"/>
    <include layout="@layout/play_header_list_pull_refresh"/>
</merge>
