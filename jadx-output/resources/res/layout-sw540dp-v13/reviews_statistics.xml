<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.HistogramView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.android.vending"
    android:id="@+id/reviews_statistics_panel"
    android:paddingLeft="@dimen/details_statistics_padding"
    android:paddingRight="@dimen/details_new_content_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="28dp"
    android:layout_marginBottom="27dp"
    finsky:needs_height_correction="true">
    <TextView
        android:textSize="72sp"
        android:textColor="@color/play_fg_primary"
        android:layout_gravity="start"
        android:id="@+id/average_value"
        android:paddingRight="8dp"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        style="@style/PlayLightText"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/average_value"
        layout="@layout/ratings_summary"/>
    <com.google.android.finsky.layout.HistogramTable
        android:layout_gravity="end"
        android:id="@+id/histogram"
        android:paddingLeft="32dp"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="1"
        android:shrinkColumns="1"
        android:layout_toRightOf="@+id/average_value"
        android:layout_alignBaseline="@+id/ratings_summary_box"
        android:layout_alignParentRight="true"
        finsky:labels_on="true"
        finsky:bar_height="16dp"
        finsky:max_bar_width="221dp"
        finsky:bar_margin="0dp"/>
</com.google.android.finsky.layout.HistogramView>
