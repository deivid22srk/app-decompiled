<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.detailspage.EpisodeListModuleLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/episode_list"
    android:background="@color/play_white"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/content_generic_small_size"
        android:textColor="@color/play_fg_secondary"
        android:id="@+id/episode_list_in_progress_snippet"
        android:background="@drawable/play_highlight_overlay_light"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:text="@string/in_progress_season"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/episode_list_header"
        android:background="@drawable/play_highlight_overlay_light"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/base_new_row_height">
        <com.google.android.play.layout.PlayActionButton
            android:id="@+id/buy_button"
            android:visibility="visible"
            android:layout_centerVertical="true"
            style="@style/DetailsPage_SmallActionButton"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <Spinner
                android:id="@+id/header_spinner"
                android:background="@drawable/spinner_background_movies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:spinnerMode="dialog"
                style="@style/Play_DetailsPage_HeaderText"/>
        </FrameLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/episodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/overlay"
            android:background="@color/season_switching_overlay"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/episodes"
            android:layout_alignBottom="@+id/episodes"/>
    </RelativeLayout>
</com.google.android.finsky.detailspage.EpisodeListModuleLayout>
