<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.OrderHistoryRowView2 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.android.vending"
    android:id="@+id/order_history_row"
    style="@style/MyAccountListPageRow">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.play.layout.PlayCardThumbnail
            android:id="@+id/li_thumbnail_frame"
            finsky:app_thumbnail_padding="0dp"
            style="@style/MyAccountThumbnail2">
            <include
                android:id="@+id/li_thumbnail"
                layout="@layout/play_card_thumbnail"/>
        </com.google.android.play.layout.PlayCardThumbnail>
        <TextView
            android:id="@+id/title"
            android:layout_alignBaseline="@+id/price"
            android:layout_alignWithParentIfMissing="true"
            style="@style/MyAccountListPageTitle"/>
        <TextView
            android:id="@+id/date"
            android:layout_below="@+id/title"
            android:layout_alignBaseline="@+id/status"
            android:layout_alignWithParentIfMissing="true"
            style="@style/MyAccountListPageSubtitle"/>
        <com.google.android.play.layout.PlayTextView
            android:id="@+id/purchase_details"
            android:layout_below="@+id/status"
            finsky:lastLineOverdrawColor="@color/play_white"
            style="@style/MyAccountListPageDetails"/>
        <TextView
            android:id="@+id/price"
            style="@style/MyAccountListPagePrice"/>
        <TextView
            android:id="@+id/status"
            android:layout_below="@+id/price"
            style="@style/MyAccountListPageStatus"/>
        <com.google.android.play.layout.PlayActionButton
            android:id="@+id/refund_button"
            android:layout_alignParentBottom="true"
            android:layout_alignWithParentIfMissing="true"
            style="@style/MyAccountRowButton2"/>
        <com.google.android.play.layout.PlayActionButton
            android:id="@+id/open_button"
            android:layout_alignParentBottom="true"
            style="@style/MyAccountRowButton2"/>
    </RelativeLayout>
</com.google.android.finsky.layout.OrderHistoryRowView2>
