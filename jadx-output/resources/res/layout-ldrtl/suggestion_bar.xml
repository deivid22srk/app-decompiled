<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.SuggestionBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/play_highlight_overlay_light"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/suggestion_line_full"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/content_generic_medium_size"
            android:textColor="@color/play_primary_text"
            android:id="@+id/suggestion_line_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/PlayLightText"/>
        <TextView
            android:textSize="@dimen/content_generic_medium_size"
            android:textStyle="italic|bold"
            android:textColor="@color/play_primary_text"
            android:id="@+id/suggestion_line_query"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
    <TextView
        android:textSize="@dimen/content_generic_medium_size"
        android:textColor="@color/play_primary_text"
        android:id="@+id/suggestion_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        style="@style/PlayLightText"/>
    <TextView
        android:textSize="@dimen/content_generic_medium_size"
        android:textStyle="italic|bold"
        android:textColor="@color/play_primary_text"
        android:ellipsize="marquee"
        android:id="@+id/suggestion_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:singleLine="true"/>
    <View
        android:id="@+id/suggestion_underline"
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
</com.google.android.finsky.layout.SuggestionBarLayout>
