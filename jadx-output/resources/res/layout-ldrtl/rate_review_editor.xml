<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.RateReviewEditor xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:textColor="#202020"
        android:gravity="center_horizontal"
        android:id="@+id/item_title"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        style="@style/PlayPlainText"/>
    <include
        android:id="@+id/rating_setter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/rating_bar"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:id="@+id/rating_description"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/review_dialog_unrated"
        android:freezesText="true"/>
    <EditText
        android:id="@+id/review_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/review_dialog_subject_hint"
        android:freezesText="true"
        android:inputType="textAutoCorrect"
        android:imeOptions="actionNext"/>
    <com.google.android.finsky.layout.MultiLineDoneButtonEditText
        android:gravity="top"
        android:id="@+id/review_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/review_dialog_body_hint"
        android:minLines="3"
        android:maxLength="@integer/max_review_length"
        android:freezesText="true"
        android:inputType="textMultiLine"/>
</com.google.android.finsky.layout.RateReviewEditor>
