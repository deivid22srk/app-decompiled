<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store">
    <com.google.android.finsky.layout.DetailsSummaryWishlistView
        android:id="@+id/title_wishlist_button"
        android:background="@drawable/play_highlight_overlay_light"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.google.android.play.layout.PlayTextView
        android:id="@+id/title_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        finsky:allowsCompactLineSpacing="true"
        style="@style/PlayDetailTitle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/title_creator_panel"
        android:background="@drawable/play_highlight_overlay_light"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.finsky.layout.DecoratedTextView
            android:id="@+id/title_creator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            style="@style/Play_DetailsPage_Subtitle"/>
    </LinearLayout>
    <com.google.android.finsky.layout.DetailsTitleFlowLayout
        android:id="@+id/title_rating_size"
        android:paddingBottom="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        finsky:separator_gap_size="20dp"
        finsky:separator_bullet_size="4dp">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/title_content_rating_panel"
            android:background="@drawable/play_highlight_overlay_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.play.image.FifeImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/title_content_rating_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"/>
            <com.google.android.finsky.layout.DecoratedTextView
                android:id="@+id/title_content_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Play_DetailsPage_Subtitle"/>
        </LinearLayout>
        <com.google.android.finsky.layout.DecoratedTextView
            android:id="@+id/title_app_size_rating_line"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Play_DetailsPage_Subtitle"/>
    </com.google.android.finsky.layout.DetailsTitleFlowLayout>
    <com.google.android.finsky.layout.DecoratedTextView
        android:textSize="13sp"
        android:ellipsize="end"
        android:id="@+id/title_tipper_sticker"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"/>
    <include layout="@layout/details_title_creator_block"/>
    <com.google.android.finsky.layout.DetailsTitleFlowLayout
        android:id="@+id/title_bylines"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        finsky:separator_gap_size="6dp"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="vertical"
        android:id="@+id/title_extra_labels"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.google.android.finsky.layout.DetailsSummaryDynamic
        android:id="@+id/title_details_summary_dynamic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.google.android.finsky.layout.DetailsButtonLayout
            android:id="@+id/button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <include layout="@layout/details_action_buttons"/>
        </com.google.android.finsky.layout.DetailsButtonLayout>
        <include
            android:id="@+id/download_progress_panel"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/details_download_progress"/>
        <TextView
            android:textSize="@dimen/content_generic_small_size"
            android:textColor="@color/play_fg_secondary"
            android:gravity="center"
            android:id="@+id/summary_dynamic_status"
            android:paddingTop="4dp"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/PlayLightText"/>
    </com.google.android.finsky.layout.DetailsSummaryDynamic>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/title_extra_labels_bottom"
        android:paddingTop="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.finsky.layout.DetailsTitleFlowLayout
            android:id="@+id/extra_labels_bottom_leading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            finsky:separator_gap_size="12dp"/>
        <com.google.android.finsky.layout.DetailsTitleFlowLayout
            android:id="@+id/extra_labels_bottom_trailing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            finsky:separator_gap_size="12dp"
            finsky:separator_bullet_size="4dp"/>
    </LinearLayout>
</merge>
