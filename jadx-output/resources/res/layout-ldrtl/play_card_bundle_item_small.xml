<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.play.PlayCardViewBundleItemSmall xmlns:android="http://schemas.android.com/apk/res/android" xmlns:playcommon="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:foreground="@drawable/play_highlight_round_overlay_light"
    playcommon:playCardClipToOutline="false"
    style="@style/PlayCardViewGroup">
    <com.google.android.play.layout.PlayCardThumbnail
        android:id="@+id/li_thumbnail_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        playcommon:app_thumbnail_padding="@dimen/play_featured_grid_image_margin">
        <include
            android:id="@+id/li_thumbnail"
            layout="@layout/play_card_thumbnail"/>
    </com.google.android.play.layout.PlayCardThumbnail>
    <include layout="@layout/play_ad_container"/>
    <com.google.android.play.layout.PlayTextView
        android:id="@+id/li_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/play_card_content_vertical_inset"
        style="@style/PlayCardTitle"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/play_card_rating_badge"/>
    <com.google.android.play.layout.PlayCardLabelView
        android:id="@+id/li_label"
        android:layout_marginBottom="@dimen/play_card_content_vertical_inset"
        style="@style/PlayCardLabel"/>
    <TextView
        android:id="@+id/li_ad_label"
        android:visibility="gone"
        android:layout_marginTop="-1dp"
        style="@style/PlayAdLabel"/>
    <include
        android:id="@+id/li_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        layout="@layout/play_card_subtitle"/>
    <include
        android:id="@+id/li_snippet_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        layout="@layout/play_card_snippet"/>
    <ProgressBar
        android:id="@+id/loading_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"/>
</com.google.android.finsky.layout.play.PlayCardViewBundleItemSmall>
