<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.HistogramView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.android.vending"
    android:id="@+id/reviews_statistics_panel"
    android:paddingTop="18dp"
    android:paddingBottom="24dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    finsky:shows_bottom_separator="true">
    <TextView
        android:textSize="56sp"
        android:textColor="@color/play_fg_primary"
        android:layout_gravity="start"
        android:id="@+id/average_value"
        android:focusable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        style="@style/PlayLightText"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@+id/average_value"
        layout="@layout/ratings_summary"/>
    <com.google.android.finsky.layout.HistogramTable
        android:id="@+id/histogram"
        android:paddingTop="18dp"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="1"
        android:shrinkColumns="1"
        android:layout_below="@+id/average_value"
        finsky:labels_on="true"
        finsky:bar_height="16dp"
        finsky:max_bar_width="160dp"
        finsky:bar_margin="2dp"/>
</com.google.android.finsky.layout.HistogramView>
