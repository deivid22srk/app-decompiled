<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.play.PlayCardClusterWithNoticeView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.finsky.layout.play.PlayCardClusterWithNoticeViewContent
        android:id="@+id/cluster_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/play_merch_content_vmargin"
        finsky:card_content_padding_top="@dimen/play_merch_content_vpadding"
        finsky:card_content_padding_bottom="@dimen/play_merch_content_vpadding">
        <FrameLayout
            android:id="@+id/cover_frame"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.play.image.FifeImageView
                android:id="@+id/cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:foreground="@drawable/play_highlight_overlay_dark"
                android:scaleType="centerCrop"
                finsky:fixed_bounds="true"/>
            <View
                android:background="@drawable/overlay_shade_dark"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <com.google.android.finsky.layout.play.ProfileInfoBlock
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/info_block"
            android:paddingBottom="@dimen/play_follow_cluster_button_bottom_margin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/title"
                android:focusable="true"
                style="@style/PlayImageClusterTitle"/>
            <TextView
                android:id="@+id/subtitle"
                android:paddingBottom="@dimen/play_follow_cluster_button_top_margin"
                android:focusable="true"
                style="@style/PlayImageClusterSubtitle"/>
            <include layout="@layout/action_button"/>
        </com.google.android.finsky.layout.play.ProfileInfoBlock>
    </com.google.android.finsky.layout.play.PlayCardClusterWithNoticeViewContent>
    <com.google.android.finsky.layout.play.CardBubbleLinearLayout
        android:orientation="vertical"
        android:id="@+id/cluster_notice"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="@dimen/play_merch_content_vmargin"
        android:layout_below="@+id/cluster_content"
        finsky:playCardBubbleSize="12dp"
        style="@style/PlayCardViewGroup">
        <TextView
            android:id="@+id/notice_text"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <RelativeLayout
            android:gravity="center_vertical"
            android:layout_gravity="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="36dp">
            <TextView
                android:textSize="@dimen/content_generic_small_size"
                android:gravity="center"
                android:id="@+id/settings_label"
                android:background="@drawable/play_highlight_overlay_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:singleLine="true"
                style="@style/PlayMediumPlainText"/>
            <TextView
                android:textSize="@dimen/content_generic_small_size"
                android:gravity="center"
                android:id="@+id/ok_label"
                android:background="@drawable/play_highlight_overlay_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:singleLine="true"
                style="@style/PlayMediumPlainText"/>
        </RelativeLayout>
    </com.google.android.finsky.layout.play.CardBubbleLinearLayout>
</com.google.android.finsky.layout.play.PlayCardClusterWithNoticeView>
