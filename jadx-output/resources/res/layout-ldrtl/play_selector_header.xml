<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.IdentifiableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/bucket_header"
    android:paddingBottom="@dimen/card_list_vpadding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/play_cluster_header_height">
    <Spinner
        android:id="@+id/section_corpus_spinner"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:id="@+id/corpus_header_strip"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_separator_thickness"/>
</com.google.android.finsky.layout.IdentifiableLinearLayout>
