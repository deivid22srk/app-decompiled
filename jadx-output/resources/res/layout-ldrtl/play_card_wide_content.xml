<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:playcommon="http://schemas.android.com/apk/res-auto" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store">
    <com.google.android.play.layout.PlayCardThumbnail
        android:id="@+id/li_thumbnail_frame"
        android:layout_width="0dp"
        android:layout_height="@dimen/play_listing_card_thumbnail_size"
        finsky:app_thumbnail_padding="@dimen/play_regular_grid_image_margin">
        <include
            android:id="@+id/li_thumbnail"
            layout="@layout/play_card_thumbnail"/>
    </com.google.android.play.layout.PlayCardThumbnail>
    <com.google.android.play.layout.PlayCardLabelView
        android:id="@+id/li_label"
        android:layout_marginBottom="@dimen/play_card_content_vertical_inset"
        android:drawablePadding="4dp"
        style="@style/PlayCardLabel"/>
    <TextView
        android:id="@+id/li_ad_label"
        android:visibility="gone"
        android:layout_marginTop="-1dp"
        style="@style/PlayAdLabel"/>
    <com.google.android.play.layout.PlayTextView
        android:id="@+id/li_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/play_card_content_vertical_inset"
        android:maxLines="1"
        android:singleLine="true"
        style="@style/PlayCardTitle"/>
    <com.google.android.play.layout.PlayTextView
        android:id="@+id/li_ad_creative"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:singleLine="true"
        style="@style/PlayCardSubtitle"/>
    <include layout="@layout/play_card_app_size"/>
    <include
        android:id="@+id/li_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-2dp"
        layout="@layout/play_card_subtitle"/>
    <include
        android:id="@+id/li_subtitle_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/play_card_subtitle"/>
    <include
        android:id="@+id/li_snippet_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        layout="@layout/play_card_snippet"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="@dimen/play_card_content_vertical_inset"
        layout="@layout/play_card_rating_badge"/>
    <ProgressBar
        android:id="@+id/loading_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/li_overflow"
        android:nextFocusLeft="@+id/play_card"
        android:layout_marginTop="@dimen/play_card_overflow_top_margin"
        android:layout_alignTop="@+id/li_title"
        style="@style/PlayCardOverflow"/>
</merge>
