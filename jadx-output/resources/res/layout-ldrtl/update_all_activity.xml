<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.MaxSizeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="@dimen/update_all_dialog_width"
    android:minHeight="@dimen/update_all_dialog_height"
    finsky:max_size_layout_height="@dimen/update_all_dialog_height"
    finsky:max_width="@dimen/update_all_dialog_width">
    <FrameLayout
        android:id="@+id/main_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/play_button_bar"/>
</com.google.android.finsky.layout.MaxSizeLinearLayout>
