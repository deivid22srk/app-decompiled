<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.DetailsExpandedFrame xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/details_expanded_frame"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/left_bar"
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="match_parent"/>
    <com.google.android.finsky.layout.scroll.GestureScrollView
        android:id="@+id/details_expanded_scroller"
        android:fadingEdgeLength="0dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <com.google.android.finsky.layout.DetailsExpandedContainer
            android:orientation="vertical"
            android:id="@+id/details_expanded_container"
            android:background="@color/white"
            android:paddingTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/details_expanded_callout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                style="@style/PlayDetailDescriptionCallout"/>
            <include
                android:id="@+id/body_container1"
                layout="@layout/details_text_block"/>
            <include
                android:id="@+id/body_container2"
                layout="@layout/details_text_block"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/details_expanded_extras"
                android:paddingTop="24dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.finsky.layout.DetailsExpandedContainer>
    </com.google.android.finsky.layout.scroll.GestureScrollView>
    <View
        android:id="@+id/right_bar"
        android:background="@color/white"
        android:layout_width="0dp"
        android:layout_height="match_parent"/>
</com.google.android.finsky.layout.DetailsExpandedFrame>
