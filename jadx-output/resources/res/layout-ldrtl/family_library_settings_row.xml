<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.activities.FamilyLibrarySettingsRowView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="12dp"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/play_highlight_overlay_light">
    <ImageView
        android:id="@+id/vertical_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_centerVertical="true"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:id="@+id/vertical_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <CheckBox
        android:id="@+id/vertical_checkbox"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"/>
</com.google.android.finsky.activities.FamilyLibrarySettingsRowView>
