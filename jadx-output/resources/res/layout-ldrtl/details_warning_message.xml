<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.WarningMessageSection xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/warning_message_panel"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:focusable="true"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/details_special_row_min_height">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/details_warning_info_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"/>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/details_warning_info_first_line"
            style="@style/WarningMessageText"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/details_warning_info_second_line"
            android:paddingTop="2dp"
            style="@style/WarningMessageText"/>
    </LinearLayout>
</com.google.android.finsky.layout.WarningMessageSection>
