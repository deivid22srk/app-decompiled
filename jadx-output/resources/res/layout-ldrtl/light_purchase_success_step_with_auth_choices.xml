<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.play.layout.PlayTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/payment_success"
        style="@style/LightPurchase_TitleText"/>
    <TextView
        android:textSize="@dimen/play_purchase_secondary_size"
        android:textColor="@color/play_fg_secondary"
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/PlayPlainText"/>
    <com.google.android.finsky.layout.AuthChoicesButtonBarLayout
        android:id="@+id/play_purchase_auth_choices_button_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/choice_everytime_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.play.layout.PlayActionButton
                android:id="@+id/choice_everytime_button"
                style="@style/Play_Purchase_ActionButton"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/choice_session_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.play.layout.PlayActionButton
                android:id="@+id/choice_session_button"
                style="@style/Play_Purchase_ActionButton"/>
        </FrameLayout>
    </com.google.android.finsky.layout.AuthChoicesButtonBarLayout>
</LinearLayout>
