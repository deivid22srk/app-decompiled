<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.CheckableLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.android.vending"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:addStatesFromChildren="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?android:attr/listPreferredItemHeight"
    finsky:checkableChildId="@+id/setup_wizard_device_name">
    <CheckedTextView
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center_vertical"
        android:id="@+id/setup_wizard_device_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="10dp"
        android:drawableStart="?android:attr/listChoiceIndicatorSingle"/>
    <TextView
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="?android:attr/textColorSecondary"
        android:id="@+id/device_usage_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</com.google.android.finsky.layout.CheckableLinearLayout>
