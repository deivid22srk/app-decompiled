<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.ErrorFooter xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/content_generic_small_size"
        android:gravity="center"
        android:id="@+id/error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/network_error"
        android:drawablePadding="6dp"
        android:drawableStart="@drawable/ic_network_error"/>
    <Button
        android:ellipsize="marquee"
        android:id="@+id/retry_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/network_retry"
        android:singleLine="true"/>
</com.google.android.finsky.layout.ErrorFooter>
