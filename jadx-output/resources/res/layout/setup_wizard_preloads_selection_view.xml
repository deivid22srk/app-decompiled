<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/content_generic_medium_size"
        android:textColor="?android:attr/textColorPrimary"
        android:id="@+id/setup_wizard_optional_preloads_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/setup_wizard_optional_apps_title"/>
    <TextView
        android:textColor="?android:attr/textColorPrimary"
        android:id="@+id/setup_wizard_preloads_loading"
        android:text="@string/loading"
        style="@style/SetupWizardMenuSelectorText"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/setup_wizard_preloads_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
