<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.CategoryRowV2 xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/play_white_with_highlight"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/category_row_height_v2">
    <com.google.android.play.image.FifeImageView
        android:id="@+id/category_item_image"
        android:layout_width="@dimen/category_icon_size"
        android:layout_height="@dimen/category_icon_size"
        android:layout_marginLeft="@dimen/category_list_horizontal_margin"
        android:scaleType="fitCenter"/>
    <com.google.android.finsky.layout.AccessibleTextView
        android:textSize="@dimen/content_generic_medium_size"
        android:gravity="center_vertical"
        android:id="@+id/category_item_title"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/category_list_horizontal_margin"
        android:layout_marginRight="@dimen/category_list_horizontal_margin"
        style="@style/PlayCardTitle"/>
</com.google.android.finsky.layout.CategoryRowV2>
