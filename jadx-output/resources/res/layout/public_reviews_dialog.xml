<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.MaxWidthLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:orientation="vertical"
    android:id="@+id/public_reviews_container"
    android:background="@drawable/rate_review_bg"
    android:paddingTop="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/light_purchase_dialog_width"
    finsky:max_width="@dimen/light_purchase_dialog_width">
    <include layout="@layout/review_google_plus_header"/>
    <ScrollView
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/play_large_size"
            android:id="@+id/public_reviews_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gplus_public_reviews"
            style="@style/PlayDetailDescription"/>
    </ScrollView>
    <include layout="@layout/button_bar"/>
</com.google.android.finsky.layout.MaxWidthLinearLayout>
