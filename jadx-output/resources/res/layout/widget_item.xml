<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:id="@+id/widget_base"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/widget_promo"
        android:background="@drawable/phonesky_widget_top"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:src="@color/black"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        android:cropToPadding="true"/>
    <RelativeLayout
        android:background="@drawable/phonesky_widget_bottom"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_bottom_height">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/widget_logo"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:src="@mipmap/ic_launcher_play_store"
            android:scaleType="fitCenter"
            android:layout_alignParentLeft="true"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/grey"
            android:ellipsize="marquee"
            android:id="@+id/widget_title"
            android:paddingLeft="3dp"
            android:paddingTop="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_toRightOf="@+id/widget_logo"
            android:layout_alignParentTop="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/grey"
            android:ellipsize="marquee"
            android:id="@+id/widget_creator"
            android:paddingLeft="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_toRightOf="@+id/widget_logo"
            android:layout_below="@+id/widget_title"/>
    </RelativeLayout>
</LinearLayout>
