<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.LightPurchaseCartLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:orientation="vertical"
    android:id="@+id/cart_details"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/header"
        android:background="@drawable/play_highlight_overlay_light"
        android:focusable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <com.google.android.play.layout.PlayTextView
                android:ellipsize="marquee"
                android:layout_gravity="start"
                android:id="@+id/item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:maxLines="2"
                style="@style/LightPurchase_TitleText"/>
            <TextView
                android:ellipsize="marquee"
                android:layout_gravity="start"
                android:id="@+id/item_subtitle"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:maxLines="2"
                style="@style/LightPurchase_SubtitleText"/>
            <TextView
                android:ellipsize="marquee"
                android:layout_gravity="start"
                android:id="@+id/instrument"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:maxLines="2"
                android:drawablePadding="8dp"
                style="@style/LightPurchase_SubtitleText"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.google.android.finsky.layout.AccessibleTextView
                android:id="@+id/item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="3dp"
                finsky:playAccessibilityClassOverride="android.widget.Button"
                style="@style/LightPurchase_Price"/>
            <TextView
                android:ellipsize="marquee"
                android:gravity="end"
                android:id="@+id/price_byline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:maxWidth="160dp"
                android:maxLines="2"
                style="@style/LightPurchase_PriceByline"/>
            <TextView
                android:ellipsize="marquee"
                android:gravity="end"
                android:id="@+id/price_byline_2"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:maxWidth="160dp"
                android:maxLines="2"
                style="@style/LightPurchase_PriceByline"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/detail_messages"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/instrument_error_message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/LightPurchase_ErrorByline"/>
    <include
        android:id="@+id/selected_voucher_container"
        layout="@layout/selected_voucher_container"/>
    <CheckBox
        android:id="@+id/split_tender_checkbox"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:minHeight="@dimen/standard_button_touch_target_minsize"
        style="@style/LightPurchase_Split_Tender"/>
    <ScrollView
        android:id="@+id/purchase_details"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@color/play_translucent_separator_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/payment_settings"
                android:background="@drawable/play_highlight_overlay_light"
                android:paddingLeft="8dp"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/payment_methods"
                style="@style/LightPurchase_PaymentSettingsLink"/>
            <View
                android:id="@+id/redeem_separator"
                android:background="@color/play_translucent_separator_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/redeem"
                android:background="@drawable/play_highlight_overlay_light"
                android:paddingLeft="8dp"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:text="@string/redeem_gift_card_menu"
                style="@style/LightPurchase_PaymentSettingsLink"/>
            <View
                android:background="@color/play_translucent_separator_line"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/voucher_header"
                android:background="@drawable/focus_overlay"
                android:paddingLeft="8dp"
                android:focusable="true"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                style="@style/LightPurchase_PaymentSettingsLink"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/vouchers"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/voucher_separator"
                android:background="@color/play_translucent_separator_line"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <TextView
                android:id="@+id/account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                style="@style/LightPurchase_AccountName"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/extended_detail_messages"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/gift_contents"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <TextView
            android:ellipsize="end"
            android:id="@+id/gift_to_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:singleLine="true"
            style="@style/LightPurchase_Details"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/gift_from_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/LightPurchase_Details"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/gift_message"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            style="@style/LightPurchase_Details"/>
    </LinearLayout>
    <TextView
        android:id="@+id/instrument_setup_message"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/LightPurchase_InstrumentSetupMessage"/>
    <TextView
        android:id="@+id/footer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/LightPurchase_Footer"/>
</com.google.android.finsky.layout.LightPurchaseCartLayout>
