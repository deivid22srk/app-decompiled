<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.detailspage.WarningMessageModuleLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/warning_message_module"
    android:paddingLeft="@dimen/details_new_content_margin"
    android:paddingTop="8dp"
    android:paddingRight="@dimen/details_new_content_margin"
    android:paddingBottom="8dp"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/details_special_row_min_height">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/warning_message_icon"
        android:paddingRight="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@null"/>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/warning_message"
        style="@style/WarningMessageText"/>
</com.google.android.finsky.detailspage.WarningMessageModuleLayout>
