<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:im="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/nfc_instruction_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/nfc_popup_message"
            android:paddingLeft="?attr/uicDialogBodyStartEndMargin"
            android:paddingTop="?attr/uicDialogBodyTopBottomMargin"
            android:paddingRight="?attr/uicDialogBodyStartEndMargin"
            android:paddingBottom="?attr/uicDialogBodyTopBottomMargin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/uicInfoDialogTextAppearance"/>
        <com.google.android.wallet.ui.common.FifeNetworkImageView
            android:id="@+id/nfc_instruction_image"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerInside"
            im:internalUicAspectRatio="1.2218"
            im:internalUicDominantDimension="width"/>
    </LinearLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/nfc_instruction_spinner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="?android:attr/progressBarStyle"/>
</FrameLayout>
