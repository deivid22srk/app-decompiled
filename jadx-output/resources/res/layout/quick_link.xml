<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.play.PlayQuickLinkBase xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="true"
    android:layout_width="0dp"
    android:layout_height="@dimen/quick_link_height"
    android:layout_weight="1"
    style="@style/PlayCardViewGroup">
    <com.google.android.play.image.FifeImageView
        android:id="@+id/li_icon"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/quick_link_padding"
        android:layout_marginTop="@dimen/quick_link_padding"
        android:layout_marginBottom="@dimen/quick_link_padding"
        android:scaleType="fitCenter"/>
    <TextView
        android:textSize="@dimen/play_quick_link_size"
        android:ellipsize="marquee"
        android:id="@+id/li_title"
        android:paddingLeft="@dimen/quick_link_padding"
        android:paddingRight="@dimen/quick_link_padding"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="2"
        style="@style/PlayMediumBoldText"/>
</com.google.android.finsky.layout.play.PlayQuickLinkBase>
