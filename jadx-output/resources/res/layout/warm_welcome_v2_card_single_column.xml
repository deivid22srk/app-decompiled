<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.play.WarmWelcomeV2Card xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.play.layout.CardLinearLayout
        android:orientation="vertical"
        android:id="@+id/warm_welcome_v2_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/PlayCardViewGroup">
        <FrameLayout
            android:id="@+id/warm_welcome_v2_graphic_box"
            android:paddingTop="32dp"
            android:layout_width="match_parent"
            android:layout_height="160dp">
            <com.google.android.play.image.FifeImageView
                android:id="@+id/warm_welcome_v2_graphic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <include layout="@layout/warm_welcome_v2_card_details"/>
    </com.google.android.play.layout.CardLinearLayout>
</com.google.android.finsky.layout.play.WarmWelcomeV2Card>
