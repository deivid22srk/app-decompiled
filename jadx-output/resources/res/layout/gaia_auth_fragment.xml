<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/gaia_auth_fragment"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="@dimen/finsky_dialog_width">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content"
        android:paddingLeft="16dp"
        android:paddingTop="12dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/challenge_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/LightPurchase_TitleText"/>
        <TextView
            android:id="@+id/challenge_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            style="@style/LightPurchase_AccountName"/>
        <EditText
            android:textSize="@dimen/content_generic_large_size"
            android:id="@+id/password"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:hint="@string/google_password_hint"
            android:singleLine="true"
            android:inputType="textPassword"
            android:imeOptions="flagNoExtractUi"
            android:contentDescription="@string/google_password_hint"/>
        <EditText
            android:textSize="@dimen/content_generic_large_size"
            android:id="@+id/pin"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:hint="@string/google_pin_hint"
            android:singleLine="true"
            android:inputType="numberPassword"
            android:imeOptions="flagNoExtractUi"
            android:contentDescription="@string/google_pin_hint"/>
        <TextView
            android:textSize="@dimen/content_generic_small_size"
            android:textColor="@color/play_fg_secondary"
            android:id="@+id/opt_out_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:textSize="@dimen/content_generic_small_size"
            android:layout_gravity="center_vertical"
            android:id="@+id/challenge_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <include layout="@layout/button_bar"/>
</LinearLayout>
