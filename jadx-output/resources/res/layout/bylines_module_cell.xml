<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.detailspage.BylinesModuleCellLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/play_highlight_overlay_light"
    android:paddingLeft="4dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:focusable="true"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:layout_weight="1"
    finsky:mark_as_button="true"
    finsky:hide_separator="true">
    <ImageView
        android:id="@+id/byline_thumbnail"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="fitCenter"/>
    <TextView
        android:textSize="@dimen/content_generic_small_size"
        android:textColor="@color/play_fg_primary"
        android:id="@+id/byline_title"
        android:paddingLeft="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/PlayPlainText"/>
</com.google.android.finsky.detailspage.BylinesModuleCellLayout>
