<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.play.PlayBundleContainerViewRow xmlns:android="http://schemas.android.com/apk/res/android" xmlns:playcommon="http://schemas.android.com/apk/res-auto" xmlns:finsky="http://schemas.android.com/apk/res/com.android.vending"
    android:paddingLeft="@dimen/play_card_content_horizontal_inset"
    android:paddingTop="8dp"
    android:paddingRight="@dimen/play_card_content_horizontal_inset"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/play_highlight_round_overlay_light"
    finsky:card_supports_subtitle_and_rating="true"
    style="@style/PlayCardViewGroup">
    <com.google.android.play.layout.PlayCardThumbnail
        android:id="@+id/li_thumbnail_frame"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_margin="@dimen/play_regular_grid_image_margin">
        <include
            android:id="@+id/li_thumbnail"
            layout="@layout/play_card_thumbnail"/>
    </com.google.android.play.layout.PlayCardThumbnail>
    <com.google.android.play.layout.PlayTextView
        android:ellipsize="end"
        android:id="@+id/li_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/play_card_content_horizontal_inset"
        android:layout_marginTop="@dimen/play_card_content_vertical_inset"
        android:lines="1"
        android:singleLine="true"
        android:layout_toRightOf="@+id/li_thumbnail_frame"
        style="@style/PlayCardTitle"/>
    <include
        android:id="@+id/li_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/play_card_content_horizontal_inset"
        android:layout_marginTop="-2dp"
        android:layout_toRightOf="@+id/li_thumbnail_frame"
        android:layout_below="@+id/li_title"
        layout="@layout/play_card_subtitle"/>
    <com.google.android.finsky.layout.DecoratedTextView
        android:ellipsize="end"
        android:id="@+id/li_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/play_card_content_horizontal_inset"
        android:layout_marginTop="-2dp"
        android:lines="2"
        android:minLines="2"
        android:layout_toRightOf="@+id/li_thumbnail_frame"
        android:layout_below="@+id/li_subtitle"
        style="@style/PlayCardDescription"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/play_card_content_horizontal_inset"
        android:layout_marginTop="4dp"
        android:layout_toRightOf="@+id/li_thumbnail_frame"
        android:layout_below="@+id/li_description">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bottom_row"
            android:paddingTop="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp">
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.google.android.play.layout.StarRatingBar
                    android:id="@+id/li_rating"
                    android:numStars="5"
                    android:stepSize="0.5"
                    android:isIndicator="true"
                    style="@style/PlayRatingBarSmall"/>
            </FrameLayout>
            <com.google.android.play.layout.PlayActionButton
                android:layout_gravity="center_vertical"
                android:id="@+id/install_button"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                playcommon:use_all_caps_in_label_mode="true"
                style="@style/DetailsPage_SmallActionButton"/>
        </LinearLayout>
        <ProgressBar
            android:layout_gravity="center_vertical"
            android:id="@+id/loading_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:indeterminate="true"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
    </FrameLayout>
</com.google.android.finsky.layout.play.PlayBundleContainerViewRow>
