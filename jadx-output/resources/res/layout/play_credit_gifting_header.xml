<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.PlayCreditGiftingHeader xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/play_credit_gifting_header"
    android:background="@color/play_multi_light"
    android:layout_width="match_parent"
    android:layout_height="@dimen/play_credit_header_height">
    <View
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.google.android.play.image.FifeImageView
        android:id="@+id/gift_header_image"
        android:layout_width="240dp"
        android:layout_height="135dp"
        android:scaleType="fitStart"
        android:adjustViewBounds="true"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/play_banner_large_size"
            android:textColor="@color/play_white"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/gift_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>
        <TextView
            android:textColor="@color/play_white"
            android:id="@+id/gift_header_description"
            android:layout_marginBottom="62dp"
            style="@style/GiftLandingDescriptionText"/>
    </LinearLayout>
</com.google.android.finsky.layout.PlayCreditGiftingHeader>
