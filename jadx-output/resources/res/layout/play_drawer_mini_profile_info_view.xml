<?xml version="1.0" encoding="utf-8"?>
<com.google.android.play.drawer.PlayDrawerMiniProfileInfoView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="start|bottom"
    android:background="@drawable/drawer_mini_profile_background"
    android:paddingLeft="@dimen/play_drawer_item_left_padding"
    android:paddingRight="@dimen/play_drawer_item_right_padding"
    android:layout_width="match_parent"
    android:layout_height="@dimen/play_drawer_mini_profile_info_height">
    <TextView
        android:ellipsize="end"
        android:id="@+id/mini_display_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="24dp"
        android:maxLines="1"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/mini_toggle_account_list_button"
        android:layout_alignParentBottom="true"
        style="@style/PlayDrawerProfileNameText"/>
    <ImageView
        android:layout_gravity="end|bottom"
        android:id="@+id/mini_toggle_account_list_button"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:scaleType="center"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"/>
</com.google.android.play.drawer.PlayDrawerMiniProfileInfoView>
