<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.play.WarmWelcomeCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    finsky:supports_dynamic_title_top_padding="false">
    <com.google.android.play.layout.CardLinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/PlayCardViewGroup">
        <FrameLayout
            android:id="@+id/warm_welcome_graphic_box"
            android:padding="8dp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.google.android.play.image.FifeImageView
                android:id="@+id/warm_welcome_graphic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/warm_welcome_main_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <com.google.android.play.layout.PlayTextView
                android:id="@+id/warm_welcome_title"
                android:paddingTop="@dimen/warm_welcome_title_top_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/PlayEduCardTitle"/>
            <com.google.android.play.layout.PlayTextView
                android:id="@+id/warm_welcome_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/PlayEduCardDescription"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/warm_welcome_card_buttons"/>
        </LinearLayout>
    </com.google.android.play.layout.CardLinearLayout>
</com.google.android.finsky.layout.play.WarmWelcomeCard>
