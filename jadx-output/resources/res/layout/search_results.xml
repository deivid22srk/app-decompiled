<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_results"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.finsky.layout.play.PlayRecyclerView
        android:id="@+id/search_results_list"
        android:paddingBottom="@dimen/card_list_vpadding"
        android:fadingEdgeLength="0dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:cacheColorHint="@color/play_main_background"
        android:divider="@null"/>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/no_results_view"/>
    <Button
        android:textSize="14sp"
        android:textColor="@color/play_white"
        android:gravity="center"
        android:id="@+id/clear_family_search_filter"
        android:background="@color/play_multi_primary"
        android:text="@string/show_all_search_results_title"
        style="@style/ClearFamilySafeSearchButton"/>
</FrameLayout>
