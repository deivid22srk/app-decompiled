<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:im="http://schemas.android.com/apk/res-auto"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/header"
        layout="@layout/view_form_header"/>
    <include
        android:id="@+id/card_images"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/internalUicFirstCreditCardLogoStartMargin"
        android:layout_alignTop="@+id/card_number_concealed"
        android:layout_alignBottom="@+id/card_number_concealed"
        layout="@layout/view_credit_card_images"/>
    <TextView
        android:ellipsize="start"
        android:id="@+id/card_number_concealed"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="?attr/internalUicCardNumberOneCardModeStartMargin"
        android:layout_marginBottom="?attr/uicFormVerticalMargin"
        android:minHeight="?attr/uicFormItemHeight"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/expand_icon"
        android:layout_below="@+id/header"
        style="?attr/uicFormInputTextAppearance"/>
    <ImageView
        android:id="@+id/expand_icon"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/wallet_uic_margin_touchable"
        android:src="?attr/uicExpandDrawable"
        android:scaleType="center"
        android:minWidth="@dimen/wallet_uic_minimum_tappable_item_size"
        android:minHeight="?attr/uicFormItemHeight"
        android:layout_alignTop="@+id/card_number_concealed"
        android:layout_alignBottom="@+id/card_number_concealed"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/wallet_uic_content_description_expand_credit_card"
        style="@style/UicClickableItem"/>
    <com.google.android.wallet.ui.card.CardNumberEditText
        android:id="@+id/card_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="?attr/uicFormVerticalMargin"
        android:minHeight="?attr/uicFormItemHeight"
        android:hint="@string/wallet_uic_card_number"
        android:layout_toLeftOf="@+id/ocr_icon"
        android:layout_below="@+id/card_number_concealed"
        im:internalUicValidateWhenNotVisible="true"
        style="?attr/uicFormInputTextAppearance"/>
    <ImageView
        android:id="@+id/ocr_icon"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/wallet_uic_margin_touchable"
        android:layout_marginBottom="?attr/uicFormVerticalMargin"
        android:src="?attr/uicCameraDrawable"
        android:minHeight="?attr/uicFormItemHeight"
        android:layout_toLeftOf="@+id/nfc_icon"
        android:layout_alignBottom="@+id/card_number"
        android:layout_alignWithParentIfMissing="true"
        android:contentDescription="@string/wallet_uic_scan_credit_card"
        style="@style/UicClickableItem"/>
    <ImageView
        android:id="@+id/nfc_icon"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/wallet_uic_margin_touchable"
        android:layout_marginBottom="?attr/uicFormVerticalMargin"
        android:src="?attr/uicNfcDrawable"
        android:minHeight="?attr/uicFormItemHeight"
        android:layout_alignBottom="@+id/card_number"
        android:layout_alignParentRight="true"
        android:contentDescription="@string/wallet_uic_nfc_credit_card"
        style="@style/UicClickableItem"/>
    <include
        android:id="@+id/card_logo_grid_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/card_number"
        layout="@layout/view_card_logo_grid"/>
</RelativeLayout>
