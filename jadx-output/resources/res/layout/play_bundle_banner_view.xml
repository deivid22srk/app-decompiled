<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.play.PlayBundleBannerView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:paddingTop="16dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="@dimen/play_merch_content_vmargin"
    android:layout_marginBottom="@dimen/play_merch_content_vmargin"
    android:foreground="@drawable/play_highlight_overlay_dark">
    <com.google.android.play.image.FifeImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/play_highlight_overlay_dark"
        android:scaleType="centerCrop"
        finsky:fixed_bounds="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/images"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.play.image.FifeImageView
                finsky:fixed_bounds="true"
                style="@style/BundleInstallPreviewImage"/>
            <com.google.android.play.image.FifeImageView
                finsky:fixed_bounds="true"
                style="@style/BundleInstallPreviewImage"/>
            <com.google.android.play.image.FifeImageView
                finsky:fixed_bounds="true"
                style="@style/BundleInstallPreviewImage"/>
            <com.google.android.play.image.FifeImageView
                finsky:fixed_bounds="true"
                style="@style/BundleInstallPreviewImage"/>
            <com.google.android.play.image.FifeImageView
                finsky:fixed_bounds="true"
                style="@style/BundleInstallPreviewImage"/>
        </LinearLayout>
        <TextView
            android:textColor="@color/play_white"
            android:gravity="center"
            android:id="@+id/card_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bundle_install_padding_vertical"
            android:layout_marginBottom="@dimen/bundle_install_padding_vertical"
            style="@style/PlayClusterTitle"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/buttonLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/explore_button"
                android:layout_marginRight="12dp"
                android:text="@string/explore"
                style="@style/BundleActionButton.TextView"/>
            <com.google.android.play.layout.PlayActionButton
                android:id="@+id/install_all_button"
                android:layout_marginLeft="12dp"
                style="@style/BundleActionButton.Play"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/li_overflow"
        android:paddingLeft="20dp"
        android:paddingRight="12dp"
        android:paddingBottom="20dp"
        android:src="@drawable/play_overflow_menu_light"
        android:layout_alignTop="@+id/background_image"
        android:layout_alignRight="@+id/background_image"
        android:contentDescription="@string/content_description_options"
        style="@style/PlayCardOverflow"/>
</com.google.android.finsky.layout.play.PlayBundleBannerView>
