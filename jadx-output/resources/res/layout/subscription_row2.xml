<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.SubscriptionRowView2 xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.android.vending"
    android:id="@+id/subscription_row"
    style="@style/MyAccountListPageRow">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.play.layout.PlayCardThumbnail
            android:id="@+id/li_thumbnail_frame"
            finsky:app_thumbnail_padding="0dp"
            style="@style/MyAccountThumbnail2">
            <include
                android:id="@+id/li_thumbnail"
                layout="@layout/play_card_thumbnail"/>
        </com.google.android.play.layout.PlayCardThumbnail>
        <TextView
            android:id="@+id/title"
            android:layout_toLeftOf="@+id/price"
            android:layout_toRightOf="@+id/li_thumbnail_frame"
            android:layout_alignBaseline="@+id/price"
            android:layout_alignWithParentIfMissing="true"
            style="@style/MyAccountListPageTitle"/>
        <TextView
            android:id="@+id/subscription_details"
            android:layout_toLeftOf="@+id/status"
            android:layout_toRightOf="@+id/li_thumbnail_frame"
            android:layout_below="@+id/price"
            android:layout_alignWithParentIfMissing="true"
            style="@style/MyAccountListPageSubtitle"/>
        <TextView
            android:textColor="@color/instrument_error_text"
            android:id="@+id/subscription_instrument_declined"
            android:maxLines="1"
            android:layout_toRightOf="@+id/li_thumbnail_frame"
            android:layout_below="@+id/subscription_details"
            android:layout_alignWithParentIfMissing="true"
            style="@style/MyAccountListPageDetails"/>
        <com.google.android.play.image.FifeImageView
            android:id="@+id/title_byline_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginRight="2dp"
            android:layout_toRightOf="@+id/li_thumbnail_frame"
            android:layout_below="@+id/subscription_instrument_declined"/>
        <TextView
            android:id="@+id/price"
            android:layout_alignParentRight="true"
            style="@style/MyAccountListPagePrice"/>
        <TextView
            android:id="@+id/status"
            android:layout_below="@+id/price"
            android:layout_alignParentRight="true"
            style="@style/MyAccountListPageStatus"/>
        <com.google.android.play.layout.PlayActionButton
            android:id="@+id/action_button"
            android:layout_alignParentRight="true"
            android:layout_alignParentBottom="true"
            style="@style/MyAccountRowButton2"/>
    </RelativeLayout>
</com.google.android.finsky.layout.SubscriptionRowView2>
