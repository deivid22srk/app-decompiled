<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.play.PlayCardViewPerson xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.android.vending"
    android:id="@+id/play_card"
    android:paddingLeft="8dp"
    android:paddingTop="8dp"
    android:paddingRight="8dp"
    android:paddingBottom="4dp"
    android:focusable="true"
    android:nextFocusDown="@+id/gplus_circle_status"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:foreground="@drawable/person_card_overlay_light">
    <com.google.android.play.layout.PlayCardThumbnail
        android:id="@+id/li_thumbnail_frame"
        android:padding="@dimen/play_person_card_avatar_padding"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="0dp">
        <com.google.android.finsky.layout.DocImageView
            android:id="@+id/li_thumbnail"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            finsky:fixed_bounds="true"
            finsky:is_avatar="true"/>
    </com.google.android.play.layout.PlayCardThumbnail>
    <com.google.android.play.layout.PlayTextView
        android:textColor="@color/play_primary_text_set"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/li_title"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:maxLines="1"
        android:singleLine="true"
        style="@style/PlayCardTitle"/>
    <com.google.android.finsky.layout.DecoratedTextView
        android:textSize="@dimen/play_person_subtitle_size"
        android:textColor="@color/play_secondary_text_set"
        android:gravity="center"
        android:id="@+id/circles_status"
        android:paddingLeft="2dp"
        android:paddingTop="4dp"
        android:paddingRight="2dp"
        android:paddingBottom="4dp"
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        style="@style/PlayCardSubtitle"/>
    <ImageView
        android:id="@+id/circles_status_icon"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_circles_green"/>
    <com.google.android.finsky.layout.play.PlayCirclesIcon
        android:id="@+id/gplus_circle_status"
        android:focusable="true"
        android:nextFocusUp="@+id/play_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <ProgressBar
        android:id="@+id/loading_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"/>
</com.google.android.finsky.layout.play.PlayCardViewPerson>
