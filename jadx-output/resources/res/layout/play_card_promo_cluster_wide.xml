<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.play.PlayCardPromoClusterWideView xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/play_promo_cluster_header"
        layout="@layout/play_card_cluster_header"/>
    <com.google.android.finsky.layout.play.PlayCardPromoWideContentLayout
        android:id="@+id/promo_cluster_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/play_promo_cluster_header"
        style="@style/PlayPromoCardClusterView">
        <FrameLayout
            android:id="@+id/play_promo_cluster_content"
            android:layout_width="wrap_content"
            android:layout_height="0dp"/>
        <View
            android:id="@+id/separator"
            android:background="@color/play_translucent_separator_line"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <include layout="@layout/play_card_small_promo"/>
    </com.google.android.finsky.layout.play.PlayCardPromoWideContentLayout>
</com.google.android.finsky.layout.play.PlayCardPromoClusterWideView>
