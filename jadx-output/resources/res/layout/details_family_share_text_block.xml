<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.FamilyShareTextBlock xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="@dimen/details_new_content_margin"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/details_text_section_icon_size"
        android:layout_height="@dimen/details_text_section_icon_size"
        android:layout_marginRight="@dimen/details_new_content_margin"/>
    <com.google.android.finsky.layout.DetailsTextView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/icon"
        style="@style/PlayDetailDescription"/>
</com.google.android.finsky.layout.FamilyShareTextBlock>
