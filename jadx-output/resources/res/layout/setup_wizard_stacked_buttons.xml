        android:id="@+id/negative_button"
        android:layout_width="match_parent"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="@dimen/setup_wizard_button_vertical_spacing"
        style="@style/SetupWizardButton"/>
</LinearLayout>
