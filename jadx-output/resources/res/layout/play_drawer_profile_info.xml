<?xml version="1.0" encoding="utf-8"?>
<com.google.android.play.drawer.PlayDrawerProfileInfoView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:play_common="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/play_drawer_profile_info_height">
    <com.google.android.play.image.FifeImageView
        android:id="@+id/cover_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@color/play_drawer_profile_overlay_shade"
        android:scaleType="centerCrop"
        play_common:fixed_bounds="true"/>
    <include
        android:layout_gravity="start|bottom"
        android:id="@+id/avatar"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginLeft="@dimen/play_drawer_item_left_padding"
        android:layout_marginRight="@dimen/play_drawer_item_right_padding"
        android:layout_marginBottom="68dp"
        layout="@layout/play_drawer_account_avatar"/>
    <FrameLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/secondary_avatar_frame_left"
        android:padding="4dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginRight="68dp"
        android:layout_marginBottom="80dp">
        <include
            android:id="@+id/secondary_avatar_left"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/play_drawer_account_avatar"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/secondary_avatar_frame_right"
        android:padding="4dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="80dp">
        <include
            android:id="@+id/secondary_avatar_right"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/play_drawer_account_avatar"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="bottom"
        android:id="@+id/account_info_container"
        android:paddingLeft="@dimen/play_drawer_item_left_padding"
        android:paddingRight="@dimen/play_drawer_item_right_padding"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp">
        <LinearLayout
            android:layout_gravity="start|bottom"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:ellipsize="end"
                android:id="@+id/display_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                style="@style/PlayDrawerProfileNameText"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/account_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                style="@style/PlayDrawerProfileEmailText"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end|bottom"
            android:id="@+id/toggle_account_list_button"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginBottom="8dp"
            android:scaleType="center"/>
    </FrameLayout>
</com.google.android.play.drawer.PlayDrawerProfileInfoView>
