<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="?attr/uicFormVerticalMargin"
    android:layout_marginBottom="?attr/uicFormVerticalMargin">
    <com.google.android.wallet.ui.common.CountdownButton
        android:layout_gravity="center_vertical"
        android:id="@+id/otp_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="45"
        style="?attr/uicFormButtonStyle"/>
    <com.google.android.wallet.ui.common.FormEditText
        android:layout_gravity="center_vertical"
        android:id="@+id/otp_field"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:minHeight="?attr/uicFormItemHeight"
        android:layout_weight="55"
        style="?attr/uicFormInputTextAppearance"/>
</LinearLayout>
