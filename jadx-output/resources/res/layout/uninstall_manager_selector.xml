<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="bottom"
    android:orientation="vertical"
    android:id="@+id/uninstall_selector"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="@dimen/card_list_vpadding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/play_cluster_header_height">
    <Spinner
        android:id="@+id/uninstall_selector_spinner"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"/>
    <View
        android:id="@+id/uninstall_selector_strip"
        android:background="@color/play_apps_primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/list_separator_thickness"/>
</LinearLayout>
