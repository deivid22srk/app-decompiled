<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.play.WarmWelcomeCardButton xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.deivid22srk.store"
    android:orientation="horizontal"
    android:background="@drawable/play_highlight_overlay_light"
    android:paddingLeft="@dimen/play_edu_main_content_padding"
    android:paddingTop="8dp"
    android:paddingRight="@dimen/play_edu_main_content_padding"
    android:paddingBottom="8dp"
    android:focusable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    finsky:mark_as_button="true"
    finsky:hide_separator="true">
    <com.google.android.play.image.FifeImageView
        android:id="@+id/icon"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginRight="2dp"
        android:scaleType="centerInside"/>
    <TextView
        android:textColor="@color/play_multi_primary"
        android:id="@+id/text"
        android:focusable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/PlayCardAction"/>
</com.google.android.finsky.layout.play.WarmWelcomeCardButton>
