<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:finsky="http://schemas.android.com/apk/res/com.android.vending"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <com.google.android.finsky.layout.DetailsSectionStack
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        finsky:separator_inset="16dp">
        <include layout="@layout/details_warning_message"/>
        <include
            android:id="@+id/item_details_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/inline_app_details_summary"/>
        <com.google.android.play.layout.PlayTextView
            android:id="@+id/short_description_panel"
            android:background="@color/play_white"
            android:paddingLeft="24dp"
            android:paddingTop="12dp"
            android:paddingRight="24dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="4"
            finsky:lastLineOverdrawColor="@color/play_white"
            style="@style/PlayInlineDetailDescription"/>
        <include
            android:id="@+id/screenshots_panel"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            layout="@layout/details_screenshots"/>
        <include
            android:id="@+id/footer"
            layout="@layout/inline_app_details_footer"/>
    </com.google.android.finsky.layout.DetailsSectionStack>
</ScrollView>
