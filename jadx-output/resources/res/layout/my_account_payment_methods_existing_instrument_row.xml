<?xml version="1.0" encoding="utf-8"?>
<com.google.android.finsky.layout.MyAccountPaymentMethodsExistingInstrumentRowView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/MyAccountRow">
    <com.google.android.play.image.FifeImageView
        android:id="@+id/image_icon"
        style="@style/MyAccountPaymentMethodsIcon"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:id="@+id/title"
            style="@style/MyAccountRowTitle"/>
        <TextView
            android:id="@+id/subtitle"
            style="@style/MyAccountRowSubtitle"/>
        <TextView
            android:id="@+id/byline"
            style="@style/MyAccountRowErrorByline"/>
    </LinearLayout>
    <TextView
        android:id="@+id/edit_button"
        style="@style/MyAccountPaymentMethodsRowEditButton"/>
</com.google.android.finsky.layout.MyAccountPaymentMethodsExistingInstrumentRowView>
