<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GiftEmailTitleText" parent="">
        <item name="android:textSize">@dimen/play_purchase_title_size</item>
        <item name="android:textColor">@color/play_white</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="PlayCondensedText" parent="">
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>
    <style name="PlayGridBoldText" parent="">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="PlayLightText" parent="">
        <item name="android:fontFamily">sans-serif-light</item>
    </style>
    <style name="PlayPlainText" parent="">
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="SetupWizardNavbarButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/setup_wizard_navbar_text_color</item>
        <item name="android:background">@drawable/setup_wizard_navbar_btn_bg</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:layout_weight">0</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
